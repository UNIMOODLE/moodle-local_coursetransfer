{{!
    @template local_coursetransfer/category_tree

    Recursive category subtree (nested subcategories + courses). Rendered in the
    restore wizards (preview) and in the request detail. Self-referencing partial.

    Context variables required for this template:
    * name string Category name
    * idnumber string Category idnumber (optional)
    * courses array List of { fullname, shortname }
    * categories array List of child nodes with the same shape

    Example context (json):
    {
        "name": "Facultad de Ciencias",
        "idnumber": "FAC-CIE",
        "courses": [{ "fullname": "Matemáticas I", "shortname": "MAT1" }],
        "categories": [
            { "name": "Física", "idnumber": "", "courses": [], "categories": [] }
        ]
    }
}}
<ul class="ct-tree">
    <li class="ct-tree-cat">
        <div class="ct-tree-label ct-tree-label-cat">
            <i class="fa fa-folder-o" aria-hidden="true"></i>
            <span class="ct-tree-name">{{name}}</span>
            {{#idnumber}}<span class="ct-tree-id">{{idnumber}}</span>{{/idnumber}}
        </div>
        {{#courses}}
        <div class="ct-tree-label ct-tree-label-course">
            <i class="fa fa-graduation-cap" aria-hidden="true"></i>
            <span class="ct-tree-name">{{fullname}}</span>
            {{#shortname}}<span class="ct-tree-id">{{shortname}}</span>{{/shortname}}
        </div>
        {{/courses}}
        {{#categories}}
        {{> local_coursetransfer/category_tree }}
        {{/categories}}
    </li>
</ul>
