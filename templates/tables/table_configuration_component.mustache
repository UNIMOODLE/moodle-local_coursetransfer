{{!
  @template local_coursetransfer/tables/table_configuration_component

  Example context (json):
  {
      "id": 12,
      "course_new": true,
      "target_remove_enrols": false,
      "target_remove_groups": false,
      "target_remove_activities": false,
      "target_merge_activities": true,
      "origin_enrol_users": true,
      "origin_remove_course": false,
      "origin_schedule": true,
      "has_scheduled_time": true,
      "origin_schedule_datetime": "2026-09-14 10:00"
  }
}}
<div data-region="table_configuration_component">
    <button type="button" class="btn btn-light configuration" data-toggle="modal" data-target="#ModalConfiguration-{{ id }}" data-bs-toggle="modal" data-bs-target="#ModalConfiguration-{{ id }}">
        {{#str}} configuration_detail, local_coursetransfer {{/str}}
    </button>
    <!-- Modal -->
    <div class="modal fade bd-example-modal-lg" id="ModalConfiguration-{{ id }}" tabindex="-1" role="dialog"
         aria-labelledby="ModalConfiguration-{{ id }}LongTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ModalConfiguration-{{ id }}LongTitle">Configuration</h5>
                    <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    {{# course_new }}
                    <h5 class="mb-4">{{#str}} restoretnewcourse, local_coursetransfer {{/str}}</h5>
                    {{/ course_new }}
                    {{^ course_new }}
                    <h5>{{#str}} restoretocurrentcourse, backup {{/str}}</h5>
                    <ul class="configuration-list">
                        <li class="configuration-group">
                            <div class="checkbox">
                                {{#target_merge_activities}}
                                    <i class="fa fa-check-circle-o text-success" aria-hidden="true"></i>
                                {{/target_merge_activities}}
                                {{^target_merge_activities}}
                                    <i class="fa fa-circle-o text-muted" aria-hidden="true"></i>
                                {{/target_merge_activities}}
                            </div>
                            <div class="config-info">
                                <div class="config-title">{{#str}} config_target_merge_activities, local_coursetransfer {{/str}}</div>
                                <div class="config-desc">{{#str}} config_target_merge_activities_desc, local_coursetransfer {{/str}}.</div>
                            </div>
                        </li>
                        <li class="configuration-group">
                            <div class="checkbox">
                                {{#target_remove_activities}}
                                    <i class="fa fa-check-circle-o text-success" aria-hidden="true"></i>
                                {{/target_remove_activities}}
                                {{^target_remove_activities}}
                                    <i class="fa fa-circle-o text-muted" aria-hidden="true"></i>
                                {{/target_remove_activities}}
                            </div>
                            <div class="config-info">
                                <div class="config-title">{{#str}} config_target_remove_activities, local_coursetransfer {{/str}}</div>
                                <div class="config-desc">{{#str}} config_target_remove_groups_desc, local_coursetransfer {{/str}}</div>
                            </div>
                        </li>
                    </ul>
                    {{/ course_new }}
                    <h5>{{#str}} deleteintarget, local_coursetransfer {{/str}}</h5>
                    <ul class="configuration-list">
                        <li class="configuration-group">
                            <div class="checkbox">
                                {{#target_remove_enrols}}
                                    <i class="fa fa-check-circle-o text-success" aria-hidden="true"></i>
                                {{/target_remove_enrols}}
                                {{^target_remove_enrols}}
                                    <i class="fa fa-circle-o text-muted" aria-hidden="true"></i>
                                {{/target_remove_enrols}}
                            </div>
                            <div class="config-info">
                                <div class="config-title">{{#str}} config_target_remove_enrols, local_coursetransfer {{/str}}</div>
                                <div class="config-desc">{{#str}} config_target_remove_enrols_desc, local_coursetransfer {{/str}}</div>
                            </div>
                        </li>
                        <li class="configuration-group">
                            <div class="checkbox">
                                {{#target_remove_groups}}
                                    <i class="fa fa-check-circle-o text-success" aria-hidden="true"></i>
                                {{/target_remove_groups}}
                                {{^target_remove_groups}}
                                    <i class="fa fa-circle-o text-muted" aria-hidden="true"></i>
                                {{/target_remove_groups}}
                            </div>
                            <div class="config-info">
                                <div class="config-title">{{#str}} config_target_remove_groups, local_coursetransfer {{/str}}</div>
                                <div class="config-desc">{{#str}} config_target_remove_groups_desc, local_coursetransfer {{/str}}</div>
                            </div>
                        </li>
                    </ul>
                    <h5>{{#str}} restore_origin_data, local_coursetransfer {{/str}}</h5>
                    <ul class="configuration-list">
                            <li class="configuration-group">
                                <div class="checkbox">
                                    {{#origin_enrol_users}}
                                        <i class="fa fa-check-circle-o text-success" aria-hidden="true"></i>
                                    {{/origin_enrol_users}}
                                    {{^origin_enrol_users}}
                                        <i class="fa fa-circle-o text-muted" aria-hidden="true"></i>
                                    {{/origin_enrol_users}}
                                </div>
                                <div class="config-info">
                                    <div class="config-title">{{#str}} restore_origin_user_data, local_coursetransfer {{/str}}</div>
                                    <div class="config-desc">{{#str}} restore_origin_user_data_desc, local_coursetransfer {{/str}}</div>
                                </div>
                            </li>
                            <li class="configuration-group">
                                <div class="checkbox">
                                    {{#origin_remove_course}}
                                        <i class="fa fa-check-circle-o text-success" aria-hidden="true"></i>
                                    {{/origin_remove_course}}
                                    {{^origin_remove_course}}
                                        <i class="fa fa-circle-o text-muted" aria-hidden="true"></i>
                                    {{/origin_remove_course}}
                                </div>
                                <div class="config-info">
                                    <div class="config-title">{{#str}} restore_origin_remove, local_coursetransfer {{/str}}</div>
                                    <div class="config-desc">{{#str}} restore_origin_remove_desc, local_coursetransfer {{/str}}</div>
                                </div>
                            </li>
                        {{#has_scheduled_time }}
                        <li class="configuration-group">
                            <div class="checkbox">
                                {{#origin_schedule}}
                                    <i class="fa fa-check-circle-o text-success" aria-hidden="true"></i>
                                {{/origin_schedule}}
                                {{^origin_schedule}}
                                    <i class="fa fa-circle-o text-muted" aria-hidden="true"></i>
                                {{/origin_schedule}}
                            </div>
                            <div class="config-info">
                                <div class="config-title">{{#str}} origin_schedule, local_coursetransfer {{/str}}</div>
                                <div class="config-desc">{{#str}} origin_schedule_desc, local_coursetransfer {{/str}}</div>
                            </div>
                        </li>
                        <li class="configuration-group ml-6 ms-6">
                            <div class="config-info">
                                <div class="config-title">{{#str}} origin_schedule_datetime, local_coursetransfer {{/str}}</div>
                            </div>
                            <div class="checkbox">
                                <input class="configuration-checkbox" id="origin_schedule" type="datetime-local" value="{{origin_schedule_datetime}}" disabled>
                            </div>
                        </li>
                        {{/has_scheduled_time }}
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
