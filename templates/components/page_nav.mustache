{{!
  @template local_coursetransfer/components/page_nav

  Shared footer navigation for every plugin screen: back to settings and
  plugin summary.

  Example context (json):
  {
    "back": "#",
    "summary": "#"
  }
}}
<div class="ct-pagenav">
    <a class="ct-btn ct-btn--secondary ct-btn--sm" href="{{ back }}">
        <i class="fa fa-cog" aria-hidden="true"></i>
        {{#str}} configuration, local_coursetransfer {{/str}}
    </a>
    <a class="ct-btn ct-btn--secondary ct-btn--sm" href="{{ summary }}">
        <i class="fa fa-list" aria-hidden="true"></i>
        {{#str}} summary, local_coursetransfer {{/str}}
    </a>
</div>
