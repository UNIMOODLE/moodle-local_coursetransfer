{{!
  @template local_coursetransfer/restore_category_page

  Teacher/manager category-restore assistant (SPA-lite): landing + 4-step
  wizard + done, driven by local_coursetransfer/restore_category_wizard. Brings
  a remote category (all its courses, including subcategories) into the CURRENT
  category.

  Example context (json):
  {
      "catid": 5,
      "catname": "Faculty of Science",
      "caturl": "https://example.com/course/index.php?categoryid=5",
      "localsite": "This site",
      "site": "Campus 2025",
      "pagesize": 10,
      "hasrecent": true,
      "recent": [
          {
              "date": "14/09/2026 10:00",
              "site": "Campus 2025",
              "summary": "Category: Faculty of Science",
              "statuslabel": "Completed",
              "badgeclass": "ct-badge--ok",
              "detailurl": "https://example.com/local/coursetransfer/log.php?id=1",
              "iserror": false,
              "errcause": "",
              "erraction": ""
          }
      ]
  }
}}
<div class="local-coursetransfer ct-wide" data-region="restore_category"
        data-catid="{{ catid }}" data-catname="{{ catname }}" data-localsite="{{ localsite }}"
        data-caturl="{{ caturl }}" data-pagesize="{{ pagesize }}">

    <div class="ct-hero">
        {{> local_coursetransfer/components/page_header }}
        <a href="{{ caturl }}" class="ct-btn ct-btn--secondary ct-btn--sm">
            <i class="fa fa-arrow-left" aria-hidden="true"></i>
            {{#str}} rcc_back_cat, local_coursetransfer {{/str}}
        </a>
    </div>

    {{! ===================== LANDING ===================== }}
    <div data-region="landing">
        <div class="ct-startcard">
            <span class="ct-startcard-icon"><i class="fa fa-download" aria-hidden="true"></i></span>
            <div class="ct-startcard-body">
                <h2 class="ct-startcard-title">{{#str}} rcc_start, local_coursetransfer {{/str}}</h2>
                <p class="ct-startcard-desc">{{#str}} rcc_start_desc, local_coursetransfer {{/str}}</p>
            </div>
            <button type="button" class="ct-btn ct-btn--primary" data-action="start">
                <i class="fa fa-plus" aria-hidden="true"></i>
                {{#str}} rcc_start_btn, local_coursetransfer {{/str}}
            </button>
        </div>

        <div class="ct-recent">
            <div class="ct-recent-head">
                <h2>{{#str}} rcc_recent, local_coursetransfer {{/str}}</h2>
                <span class="ct-recent-spacer" style="flex:1"></span>
            </div>
            {{#hasrecent}}
            <div class="ct-recent-list">
                {{#recent}}
                <div class="ct-recent-card">
                    <div class="ct-recent-row">
                        <span class="ct-badge {{ badgeclass }}">{{ statuslabel }}</span>
                        <span class="ct-recent-summary">{{ summary }}</span>
                        <span class="ct-text-muted">{{ date }}</span>
                    </div>
                    <div class="ct-recent-row" style="margin-top:8px">
                        <span class="ct-text-muted">{{#str}} rw_review_from, local_coursetransfer {{/str}} <strong>{{ site }}</strong></span>
                        <span class="ct-recent-spacer" style="flex:1"></span>
                        <a class="ct-link-sm" href="{{ detailurl }}">{{#str}} exec_detail, local_coursetransfer {{/str}}</a>
                    </div>
                    {{#iserror}}
                    <div class="ct-alert ct-alert--danger ct-mt">
                        <i class="fa fa-exclamation-triangle ct-alert-icon" aria-hidden="true"></i>
                        <p><strong>{{ errcause }}</strong><br>{{ erraction }}</p>
                    </div>
                    {{/iserror}}
                </div>
                {{/recent}}
            </div>
            {{/hasrecent}}
            {{^hasrecent}}
            <div class="ct-recent-card ct-text-muted">{{#str}} rcc_empty_recent, local_coursetransfer {{/str}}</div>
            {{/hasrecent}}
        </div>
    </div>

    {{! ===================== WIZARD ===================== }}
    <div class="ct-card ct-wizard" data-region="wizard" hidden>

        <div class="ct-steps" data-region="steps">
            <div class="ct-step" data-step-index="0" data-state="current">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">1</span>
                    <span class="ct-step-label">{{#str}} rct_step_site, local_coursetransfer {{/str}}</span>
                </div>
                <span class="ct-step-connector"></span>
            </div>
            <div class="ct-step" data-step-index="1" data-state="pending">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">2</span>
                    <span class="ct-step-label">{{#str}} rcc_step_category, local_coursetransfer {{/str}}</span>
                </div>
                <span class="ct-step-connector"></span>
            </div>
            <div class="ct-step" data-step-index="2" data-state="pending">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">3</span>
                    <span class="ct-step-label">{{#str}} rct_step_options, local_coursetransfer {{/str}}</span>
                </div>
                <span class="ct-step-connector"></span>
            </div>
            <div class="ct-step" data-step-index="3" data-state="pending">
                <div class="ct-step-cell">
                    <span class="ct-step-marker">4</span>
                    <span class="ct-step-label">{{#str}} rw_step_confirm, local_coursetransfer {{/str}}</span>
                </div>
            </div>
        </div>

        <div class="ct-wizard-body">

            {{! Persistent origin-site header (from step 1 on). }}
            <div class="ct-sitebar" data-region="sitebar" hidden>
                <span class="ct-sitebar-icon"><i class="fa fa-download" aria-hidden="true"></i></span>
                <span class="ct-sitebar-label">{{#str}} rw_sitebar_from, local_coursetransfer {{/str}}</span>
                <span class="ct-sitebar-name" data-region="sitebar-name"></span>
            </div>

            {{! ---- STEP 0 · Platform ---- }}
            <div data-step="0">
                <h2 class="ct-section-title">{{#str}} rct_q_site, local_coursetransfer {{/str}}</h2>
                <p class="ct-step-lead">{{#str}} rct_q_site_desc, local_coursetransfer {{/str}}</p>
                <div class="ct-rolecards ct-mt" data-region="sites">
                    <div class="ct-selempty" data-region="sites-loading">{{#str}} rw_loading, local_coursetransfer {{/str}}</div>
                </div>
            </div>

            {{! ---- STEP 1 · Category (single-select) ---- }}
            <div data-step="1" hidden>
                <h2 class="ct-section-title">{{#str}} rcc_q_cat, local_coursetransfer {{/str}}</h2>
                <p class="ct-step-lead" data-region="cat-desc"></p>
                <div class="ct-search ct-mb">
                    <i class="fa fa-search" aria-hidden="true"></i>
                    <input type="text" data-action="search"
                            placeholder="{{#str}} rcc_search_ph, local_coursetransfer {{/str}}">
                </div>
                <p class="ct-result-info">
                    <span data-region="resultinfo"></span>
                    <i class="fa fa-info-circle" aria-hidden="true" data-region="resultnote"
                            title="{{#str}} rw_results_note, local_coursetransfer {{/str}}"></i>
                </p>
                <div class="ct-seltable">
                    <div class="ct-seltable-head">
                        <span style="width:20px"></span>
                        <span class="ct-col-name">{{#str}} rw_kind_category, local_coursetransfer {{/str}}</span>
                        <span class="ct-col-meta">{{#str}} rw_col_import, local_coursetransfer {{/str}}</span>
                    </div>
                    <div data-region="rows">
                        <div class="ct-selempty" data-region="rows-loading">{{#str}} rw_loading, local_coursetransfer {{/str}}</div>
                    </div>
                </div>
                <div class="ct-selpager" data-region="pager" hidden>
                    <button type="button" class="ct-iconbtn ct-iconbtn--xs" data-action="prev"
                            aria-label="{{#str}} rw_pageprev, local_coursetransfer {{/str}}"
                            title="{{#str}} rw_pageprev, local_coursetransfer {{/str}}">
                        <i class="fa fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <span class="ct-selpager-info" data-region="pageinfo"></span>
                    <button type="button" class="ct-iconbtn ct-iconbtn--xs" data-action="next-page"
                            aria-label="{{#str}} rw_pagenext, local_coursetransfer {{/str}}"
                            title="{{#str}} rw_pagenext, local_coursetransfer {{/str}}">
                        <i class="fa fa-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            {{! ---- STEP 2 · Options ---- }}
            <div data-step="2" hidden>
                <h2 class="ct-section-title">{{#str}} rcc_opt_title, local_coursetransfer {{/str}}</h2>
                <p class="ct-step-lead">{{#str}} rcc_opt_desc, local_coursetransfer {{/str}}</p>

                {{! Destination is fixed to the current category. }}
                <div class="ct-alert ct-alert--info ct-mt">
                    <i class="fa fa-folder-open-o ct-alert-icon" aria-hidden="true"></i>
                    <p>{{#str}} rcc_dest_fixed, local_coursetransfer {{/str}} <strong>{{ catname }}</strong></p>
                </div>

                <div class="ct-switchrow ct-mt">
                    <div class="ct-switchrow-body">
                        <span class="ct-rolecard-title">{{#str}} rw_users_cat, local_coursetransfer {{/str}}</span>
                        <span class="ct-rolecard-desc">{{#str}} rw_users_cat_desc, local_coursetransfer {{/str}}</span>
                    </div>
                    <button type="button" class="ct-switch" data-action="toggle-users" role="switch" aria-checked="false"></button>
                </div>

                <div class="ct-switchrow ct-switchrow--danger">
                    <div class="ct-switchrow-body">
                        <span class="ct-rolecard-title">{{#str}} rw_removeorigin_cat, local_coursetransfer {{/str}}</span>
                        <span class="ct-rolecard-desc">{{#str}} rw_removeorigin_cat_desc, local_coursetransfer {{/str}}</span>
                    </div>
                    <button type="button" class="ct-switch" data-action="toggle-removeorigin" role="switch" aria-checked="false"></button>
                </div>
                <div class="ct-removeorigin-confirm" data-region="removeorigin-confirm" hidden>
                    <button type="button" class="ct-modeopt-confirm-btn" data-action="toggle-removeorigin-confirm" role="checkbox" aria-checked="false">
                        <span class="ct-modeopt-confirm-box"><i class="fa fa-check" aria-hidden="true"></i></span>
                        <span>{{#str}} rw_removeorigin_confirm_cat, local_coursetransfer {{/str}}</span>
                    </button>
                </div>

                <div class="ct-switchrow">
                    <div class="ct-switchrow-body">
                        <span class="ct-rolecard-title">{{#str}} rw_schedule, local_coursetransfer {{/str}}</span>
                        <span class="ct-rolecard-desc">{{#str}} rw_schedule_desc, local_coursetransfer {{/str}}</span>
                        <input type="datetime-local" class="ct-input ct-schedule-input ct-mt" data-action="schedule-date" data-region="schedule-date" hidden>
                    </div>
                    <button type="button" class="ct-switch" data-action="toggle-schedule" role="switch" aria-checked="false"></button>
                </div>

                {{! Subtree preview: the hierarchy that will be recreated on the target. }}
                <div class="ct-tree-wrap ct-mt" data-region="tree" hidden>
                    <h3 class="ct-tree-title">{{#str}} rcc_tree_title, local_coursetransfer {{/str}}</h3>
                    <div class="ct-tree-body" data-region="tree-body"></div>
                </div>
            </div>

            {{! ---- STEP 3 · Review ---- }}
            <div data-step="3" hidden>
                <div data-region="review"></div>
                <div class="ct-alert ct-alert--danger ct-mt" data-region="review-removeorigin" hidden>
                    <i class="fa fa-trash ct-alert-icon" aria-hidden="true"></i>
                    <p data-region="review-removeorigin-text"></p>
                </div>
                <div class="ct-alert ct-alert--neutral ct-mt">
                    <i class="fa fa-clock-o ct-alert-icon" aria-hidden="true"></i>
                    <p>{{#str}} rw_review_async, local_coursetransfer {{/str}}</p>
                </div>
                <div class="ct-alert ct-alert--danger ct-mt" data-region="submit-error" hidden>
                    <i class="fa fa-exclamation-triangle ct-alert-icon" aria-hidden="true"></i>
                    <p data-region="submit-error-text"></p>
                </div>
            </div>

        </div>

        <div class="ct-wizard-footer">
            <button type="button" class="ct-btn ct-btn--ghost" data-action="cancel">{{#str}} rw_cancel, local_coursetransfer {{/str}}</button>
            <button type="button" class="ct-btn ct-btn--secondary" data-action="back">
                <i class="fa fa-chevron-left" aria-hidden="true"></i>{{#str}} rw_back, local_coursetransfer {{/str}}
            </button>
            <span class="ct-wizard-stepnum" data-region="stepinfo">{{#str}} rw_step_of, local_coursetransfer, {"n": 1, "total": 4} {{/str}}</span>
            <button type="button" class="ct-btn ct-btn--primary" data-action="primary" data-region="primary">
                {{#str}} rw_next, local_coursetransfer {{/str}}<i class="fa fa-chevron-right" aria-hidden="true"></i>
            </button>
        </div>

    </div>

    {{! ===================== DONE ===================== }}
    <div class="ct-card" data-region="done" hidden>
        <div class="ct-done">
            <div class="ct-done-icon"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
            <h2 class="ct-section-title">{{#str}} rcc_done_title, local_coursetransfer {{/str}}</h2>
            <p class="ct-text-muted" data-region="done-desc">{{#str}} rcc_done_desc, local_coursetransfer {{/str}}</p>
            <div class="ct-done-progress">
                <div class="ct-done-progress-step">
                    <span class="ct-done-progress-dot"><span></span></span>
                    <span class="ct-done-progress-label">{{#str}} rct_done_step1, local_coursetransfer {{/str}}</span>
                </div>
                <div class="ct-done-progress-step">
                    <span class="ct-done-progress-dot"><span></span></span>
                    <span class="ct-done-progress-label">{{#str}} rct_done_step2, local_coursetransfer {{/str}}</span>
                </div>
                <div class="ct-done-progress-step">
                    <span class="ct-done-progress-dot"><span></span></span>
                    <span class="ct-done-progress-label">{{#str}} rct_done_step3, local_coursetransfer {{/str}}</span>
                </div>
            </div>
            <p class="ct-done-note">{{#str}} rw_done_async, local_coursetransfer {{/str}}</p>
            <div class="ct-done-actions">
                <a href="{{ caturl }}" class="ct-btn ct-btn--primary">
                    <i class="fa fa-arrow-left" aria-hidden="true"></i>{{#str}} rcc_back_cat, local_coursetransfer {{/str}}
                </a>
                <button type="button" class="ct-btn ct-btn--secondary" data-action="go-landing">{{#str}} rcc_done_see, local_coursetransfer {{/str}}</button>
            </div>
        </div>
    </div>

</div>

{{#js}}
require(['local_coursetransfer/restore_category_wizard'], function(W) {
    W.init('[data-region="restore_category"]');
});
{{/js}}
